# BIG-IP Protocol Performance Tuner — Environment Variables
# Copy to .env and customise

# Grafana public URL (used by React frontend iframe embeds)
GRAFANA_EXTERNAL_URL=http://localhost:3000

# Grafana admin password
GF_SECURITY_ADMIN_PASSWORD=admin

# VictoriaMetrics retention period (default: 30d). Formats: 7d, 2w, 1m, 1y
VM_RETENTION_PERIOD=30d

# VictoriaMetrics max storage capacity (GB)
VM_MAX_STORAGE_GB=10.0

# Dedup min scrape interval — align with poll interval
VM_DEDUP_INTERVAL=15s

# BIG-IP telemetry poll interval (seconds)
TELEMETRY_POLL_INTERVAL_SECONDS=30

# Optional: provide a pre-generated Fernet key (base64-url encoded 32-byte key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BIGIP_SESSION_ENCRYPTION_KEY=
